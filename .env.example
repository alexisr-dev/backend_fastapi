# Plantilla de entorno para backend_fastapi.
# Copia este archivo como .env y reemplaza los valores entre <> por los tuyos.
# El archivo .env real NUNCA se sube al repositorio (ver .gitignore); solo
# esta plantilla se versiona.

APP_NAME=backend_fastapi
DEBUG=True

DB_NAME=<nombre_de_tu_base_de_datos>
DB_USER=postgres
DB_PASSWORD=<contraseña_de_tu_postgres>
DB_HOST=localhost
DB_PORT=5432
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Debe ser IDENTICO al JWT_SECRET de backend_restaurante (Django); si no
# coinciden, el login funciona pero este servicio responde 401 a todo.
JWT_SECRET=<mismo_secreto_que_backend_restaurante>
JWT_ALGORITHM=HS256

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

RATE_LIMIT_PEDIDOS=30
RATE_LIMIT_VENTANA_SEGUNDOS=60
